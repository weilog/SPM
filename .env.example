DATABASE_URL=postgresql://spm:change-this-local-password@127.0.0.1:5433/spm?schema=public
POSTGRES_USER=spm
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=spm
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
SESSION_HOURS=8
COOKIE_SECURE=false
# Set a private seed password before running db:seed (minimum 12 characters).
SEED_PASSWORD=
# Authentication pages: share the invitation privately; registration grants MEMBER only.
REGISTRATION_INVITE_CODE=
# Local acceptance only: show a simulated email/reset link; never sends actual mail.
AUTH_MAIL_MODE=simulation

# P1 backend only. Manual requests; external transfer is disabled by default.
AI_ENABLED=false
AI_EXTERNAL_ENABLED=false
# json-http is the documented gateway contract, not a vendor SDK.
# Native DeepSeek option: AI_PROVIDER=deepseek, AI_SUPPLIER=DeepSeek,
# AI_ENDPOINT=https://api.deepseek.com/chat/completions, AI_MODEL=deepseek-flash.
# Native adapter disables thinking; production secrets stay in this backend env only.
AI_PROVIDER=disabled
AI_SUPPLIER=
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
# Enable only after approving the actual supplier/model and evidence field scope.
# P2 planning/execution context additionally uses authorized descriptions,
# acceptance criteria, existing entity references and recent task action names:
# AI_APPROVED_DATA_SCOPE=project-planning-v2
AI_APPROVED_DATA_SCOPE=
AI_TIMEOUT_MS=15000
AI_CONCURRENCY=2
AI_WORKER_POLL_MS=1000
AI_LEASE_MS=90000
AI_MAX_RUNS_PER_MINUTE=10
AI_MAX_RUNS_PER_PROJECT_24H=100
AI_MAX_MODEL_CALLS_PER_PROJECT_24H=20
AI_MAX_RETRIES=2
AI_MAX_CONTEXT_ENTITIES=1000
AI_MAX_FINDINGS=300
AI_MAX_INPUT_BYTES=120000
AI_MAX_OUTPUT_TOKENS=2000
AI_TIME_ZONE=Asia/Shanghai
