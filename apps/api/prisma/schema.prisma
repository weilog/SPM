generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  MANAGER
  MEMBER
}
enum ProjectRole {
  MANAGER
  DEVELOPER
  TESTER
}
model User {
  id Int @id @default(autoincrement())
  username String @unique @db.VarChar(80)
  passwordHash String
  role Role @default(MEMBER)
  active Boolean @default(true)
  sessions Session[]
  managedProjects Project[]
  memberships ProjectMember[]
}
model Session {
  id String @id
  userId Int
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Project {
  id Int @id @default(autoincrement())
  name String @db.VarChar(200)
  description String @default("")
  managerId Int
  manager User @relation(fields: [managerId], references: [id], onDelete: Restrict)
  members ProjectMember[]
  tasks Task[]
  requirements Requirement[]
  goals ProductGoal[]
  epics Epic[]
  stories UserStory[]
  createdAt DateTime @default(now())
}
model ProjectMember {
  id Int @id @default(autoincrement())
  projectId Int
  userId Int
  role ProjectRole @default(DEVELOPER)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  @@unique([projectId, userId])
}
model Task {
  id Int @id @default(autoincrement())
  projectId Int
  title String @db.VarChar(200)
  description String @default("")
  status String @default("TODO") @db.VarChar(10)
  assigneeUserId Int?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeMember ProjectMember? @relation(fields: [projectId, assigneeUserId], references: [projectId, userId], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  storyLinks StoryTask[]
  @@unique([projectId, id])
}
model Requirement {
  id Int @id @default(autoincrement())
  projectId Int
  title String @db.VarChar(200)
  description String @default("") @db.VarChar(10000)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storyLinks StoryRequirement[]
  @@unique([projectId, id])
  @@index([projectId])
}

enum StoryStatus {
  TODO
  IN_PROGRESS
  DONE
}
model ProductGoal {
  id Int @id @default(autoincrement())
  projectId Int
  title String @db.VarChar(200)
  sortOrder Int @default(0)
  revision Int @default(0)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epics Epic[]
  @@unique([projectId, id])
  @@index([projectId, sortOrder])
}
model Epic {
  id Int @id @default(autoincrement())
  projectId Int
  goalId Int
  title String @db.VarChar(200)
  sortOrder Int @default(0)
  revision Int @default(0)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal ProductGoal @relation(fields: [projectId, goalId], references: [projectId, id], onDelete: Cascade)
  stories UserStory[]
  @@unique([projectId, id])
  @@index([projectId, goalId, sortOrder])
}
model UserStory {
  id Int @id @default(autoincrement())
  projectId Int
  epicId Int
  title String @db.VarChar(200)
  description String @default("") @db.VarChar(10000)
  acceptanceCriteria String @default("") @db.VarChar(10000)
  status StoryStatus @default(TODO)
  sortOrder Int @default(0)
  revision Int @default(0)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic Epic @relation(fields: [projectId, epicId], references: [projectId, id], onDelete: Cascade)
  requirementLinks StoryRequirement[]
  taskLinks StoryTask[]
  @@unique([projectId, id])
  @@index([projectId, epicId, sortOrder])
}
model StoryRequirement {
  projectId Int
  storyId Int
  requirementId Int
  story UserStory @relation(fields: [projectId, storyId], references: [projectId, id], onDelete: Cascade)
  requirement Requirement @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: Cascade)
  @@id([projectId, storyId, requirementId])
  @@index([projectId, requirementId])
}
model StoryTask {
  projectId Int
  storyId Int
  taskId Int
  story UserStory @relation(fields: [projectId, storyId], references: [projectId, id], onDelete: Cascade)
  task Task @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Cascade)
  @@id([projectId, storyId, taskId])
  @@index([projectId, taskId])
}
