generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  MANAGER
  MEMBER
}
enum ProjectRole {
  MANAGER
  DEVELOPER
  TESTER
}
model User {
  id Int @id @default(autoincrement())
  username String @unique @db.VarChar(80)
  passwordHash String
  role Role @default(MEMBER)
  active Boolean @default(true)
  sessions Session[]
  managedProjects Project[]
  memberships ProjectMember[]
}
model Session {
  id String @id
  userId Int
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Project {
  id Int @id @default(autoincrement())
  name String @db.VarChar(200)
  description String @default("")
  managerId Int
  manager User @relation(fields: [managerId], references: [id], onDelete: Restrict)
  members ProjectMember[]
  tasks Task[]
  requirements Requirement[]
  createdAt DateTime @default(now())
}
model ProjectMember {
  id Int @id @default(autoincrement())
  projectId Int
  userId Int
  role ProjectRole @default(DEVELOPER)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  @@unique([projectId, userId])
}
model Task {
  id Int @id @default(autoincrement())
  projectId Int
  title String @db.VarChar(200)
  description String @default("")
  status String @default("TODO") @db.VarChar(10)
  assigneeUserId Int?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeMember ProjectMember? @relation(fields: [projectId, assigneeUserId], references: [projectId, userId], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
}
model Requirement {
  id Int @id @default(autoincrement())
  projectId Int
  title String @db.VarChar(200)
  description String @default("") @db.VarChar(10000)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
}
